{
  "uid": "kahoots-overview",
  "title": "Kahoots Overview",
  "description": "Every service and the gateway: traffic, errors, latency, load and instances (Lab 4, Grade 10).",
  "tags": [
    "kahoots",
    "lab4"
  ],
