{
  "uid": "kahoots-analytics",
  "title": "Kahoots Analytics",
  "description": "Lab 5: game analytics from the Data Warehouse (dw-db), loaded by etl-service from all 8 service databases.",
  "tags": [
    "kahoots",
    "lab5"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
