            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT count(*) AS crafts FROM dw.fact_craft",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dw"
          },
          "refId": "A",
          "editorMode": "code",
