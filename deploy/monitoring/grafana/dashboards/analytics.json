      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT count(*) AS players FROM dw.dim_player",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dw"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "id": 2,
