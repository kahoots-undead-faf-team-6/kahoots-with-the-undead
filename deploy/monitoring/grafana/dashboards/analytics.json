  "links": [
    {
      "title": "Kahoots dashboards",
      "type": "dashboards",
      "tags": [
        "kahoots"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Data Warehouse (Lab 5): filled by etl-service from the 8 service databases",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
