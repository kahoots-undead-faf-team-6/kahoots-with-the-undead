# Copy to deploy/.env and set real passwords. Never commit deploy/.env.
# Image names are written in docker-compose.yml, so no DOCKERHUB_USER is needed.

# Optional: override image versions
GAME_VERSION=1.0.0
EXAM_VERSION=1.0.0
WORLD_VERSION=2.0.0
ZOMBIE_VERSION=2.0.0
RESOURCE_VERSION=1.0.0
BASE_VERSION=1.0.0
PLAYER_VERSION=1.0.0
CRAFTING_VERSION=1.0.0

# Game Service (Alexandru) - PostgreSQL
GAME_DB_USER=game
GAME_DB_PASSWORD=change-me
GAME_DB_NAME=game

# Exam Service (Alexandru) - PostgreSQL
EXAM_DB_USER=exam
EXAM_DB_PASSWORD=change-me
EXAM_DB_NAME=exam

# World Service (Mihai) - MongoDB
WORLD_MONGO_USER=root
WORLD_MONGO_PASSWORD=change-me

# Zombie Service (Mihai) - MongoDB
ZOMBIE_MONGO_USER=root
ZOMBIE_MONGO_PASSWORD=change-me

# Resource Service (Vladlen) - PostgreSQL
RESOURCE_DB_USER=resource_user
RESOURCE_DB_PASSWORD=change-me
RESOURCE_DB_NAME=resource_db

# Base Service (Vladlen) - PostgreSQL
BASE_DB_USER=base_user
BASE_DB_PASSWORD=change-me
BASE_DB_NAME=base_db

# Player Service (Gabriel) - PostgreSQL
PLAYER_DB_USER=player
PLAYER_DB_PASSWORD=change-me
PLAYER_DB_NAME=player
PLAYER_JWT_SECRET=change-me-to-a-long-random-string

# Crafting Service (Gabriel) - PostgreSQL
CRAFTING_DB_USER=crafting
CRAFTING_DB_PASSWORD=change-me
CRAFTING_DB_NAME=crafting
