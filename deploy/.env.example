# Copy to deploy/.env and set real passwords. Never commit deploy/.env.
# Image names are written in docker-compose.yml, so no DOCKERHUB_USER is needed.

# ---- Lab 2: gateway secrets (change every value) ----
# Signs client JWTs at the gateway.
JWT_SECRET=change-me-to-a-long-random-string
# Needed to get an admin token from POST /auth/token.
ADMIN_KEY=change-me-admin-key
# Shared by the gateway and every service; sent as X-Internal-Key on service-to-service calls.
INTERNAL_API_KEY=change-me-internal-key
# Shared by the gateway and Game; signs the direct WebSocket URLs.
WS_TOKEN_SECRET=change-me-ws-secret

# ---- Lab 2: limits (set low for the demo, e.g. 3 / 2000 and DEMO_MODE=true) ----
GATEWAY_REQUEST_TIMEOUT_MS=10000
GATEWAY_MAX_CONCURRENT_REQUESTS=100
SERVICE_REQUEST_TIMEOUT_MS=5000
SERVICE_MAX_CONCURRENT_REQUESTS=50
DEMO_MODE=false

# ---- Lab 3: Service Discovery, logs and circuit breaker (docs/lab3-contract.md) ----
# Sent to every service and the gateway (x-discovery-env in docker-compose.yml).
HEARTBEAT_INTERVAL_MS=5000
LOG_LEVEL=info
# remove = a tripped breaker removes the failing instance from Service Discovery; log = it only opens.
CIRCUIT_BREAKER_MODE=remove
# How long the gateway reuses a Service Discovery lookup.
DISCOVERY_CACHE_MS=2000

# Service Discovery: registry TTL, health checks and alerts.
HEARTBEAT_TTL_SECONDS=15
HEALTH_CHECK_INTERVAL_SECONDS=10
HEALTH_CHECK_FAILURES_BEFORE_DOWN=2
LOAD_WARN_THRESHOLD=0.7
LOAD_CRITICAL_THRESHOLD=0.9
ALERT_COOLDOWN_SECONDS=60
QUARANTINE_SECONDS=60
# Alerts to Telegram and/or Discord. Empty = not sent. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Instances of every service except Game (Game always runs game-service-1/2/3).
EXAM_REPLICAS=2
WORLD_REPLICAS=2
ZOMBIE_REPLICAS=2
RESOURCE_REPLICAS=2
BASE_REPLICAS=2
PLAYER_REPLICAS=2
CRAFTING_REPLICAS=2

# Lab 3 demo: uncomment to make the limits, alerts and breaker easy to trigger.
# DEMO_MODE=true
# SERVICE_MAX_CONCURRENT_REQUESTS=3
# HEALTH_CHECK_INTERVAL_SECONDS=3
# CIRCUIT_BREAKER_WINDOW_MS=20000

# Optional: override image versions
SD_VERSION=3.0.0
GATEWAY_VERSION=3.0.0
GAME_VERSION=3.0.0
EXAM_VERSION=3.0.0
WORLD_VERSION=3.0.0
ZOMBIE_VERSION=3.0.0
RESOURCE_VERSION=3.0.0
BASE_VERSION=3.0.0
PLAYER_VERSION=3.0.0
CRAFTING_VERSION=3.0.0

# Game Service (Alexandru) - PostgreSQL
GAME_DB_USER=game
GAME_DB_PASSWORD=change-me
GAME_DB_NAME=game

# Exam Service (Alexandru) - PostgreSQL
EXAM_DB_USER=exam
EXAM_DB_PASSWORD=change-me
EXAM_DB_NAME=exam

# World Service (Mihai) - MongoDB
WORLD_MONGO_USER=root
WORLD_MONGO_PASSWORD=change-me

# Zombie Service (Mihai) - MongoDB
ZOMBIE_MONGO_USER=root
ZOMBIE_MONGO_PASSWORD=change-me

# Resource Service (Vladlen) - PostgreSQL
RESOURCE_DB_USER=resource_user
RESOURCE_DB_PASSWORD=change-me
RESOURCE_DB_NAME=resource_db

# Base Service (Vladlen) - PostgreSQL
BASE_DB_USER=base_user
BASE_DB_PASSWORD=change-me
BASE_DB_NAME=base_db

# Player Service (Gabriel) - PostgreSQL
PLAYER_DB_USER=player
PLAYER_DB_PASSWORD=change-me
PLAYER_DB_NAME=player
PLAYER_JWT_SECRET=change-me-to-a-long-random-string

# Crafting Service (Gabriel) - PostgreSQL
CRAFTING_DB_USER=crafting
CRAFTING_DB_PASSWORD=change-me
CRAFTING_DB_NAME=crafting
# http = real calls to Resource through the gateway (Lab 2). Crafting then needs Resource to know the player ids,
# i.e. Resource with CLIENT_MODE=http. Set to mock to use Crafting's built-in Resource mock instead.
CRAFTING_RESOURCE_CLIENT=http
