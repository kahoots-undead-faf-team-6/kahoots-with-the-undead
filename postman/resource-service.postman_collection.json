            "body": {
              "mode": "raw",
              "raw": "{\n  \"actionId\": \"demo-gather-1\",\n  \"playerId\": \"{{playerId}}\",\n  \"nodeId\": \"node-2\",\n  \"amount\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Second send returns 200 with duplicate=true and the inventory is NOT increased again."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200 or 201\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
