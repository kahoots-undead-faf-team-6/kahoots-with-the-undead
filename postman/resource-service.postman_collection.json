    {
      "name": "Operations (idempotent)",
      "item": [
        {
          "name": "Gather (new actionId each time)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/resources/gather",
