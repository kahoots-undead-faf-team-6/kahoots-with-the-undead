              "path": [
                "resources",
                "gather"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actionId\": \"{{$guid}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"nodeId\": \"node-1\",\n  \"amount\": 5\n}",
