{
  "info": {
    "name": "Crafting Service",
    "description": "Team 6 - Crafting Service (Moraru Gabriel), port 3031. Seeded recipes e0000000-...-0001..0005. With the built-in mocks, alice has enough materials for several crafts; restart the service to reset the mock resources.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3031"
    },
    {
      "key": "aliceId",
      "value": "aaaaaaaa-0000-4000-8000-000000000001"
    },
    {
      "key": "bobId",
      "value": "aaaaaaaa-0000-4000-8000-000000000002"
    },
    {
      "key": "carolId",
      "value": "aaaaaaaa-0000-4000-8000-000000000003"
    },
    {
      "key": "barricadeKitId",
      "value": "e0000000-0000-4000-8000-000000000001"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test(\"ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Recipes",
      "item": [
        {
          "name": "List recipes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recipes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test(\"has the 5 seeded recipes\", () => pm.expect(pm.response.json().length).to.be.at.least(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get recipe (Barricade Kit)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recipes/{{barricadeKitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipes",
                "{{barricadeKitId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create recipe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recipes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{newRecipeName}}\",\n  \"description\": \"Food + Chemicals, but angrier\",\n  \"ingredients\": [\n    {\n      \"resourceTypeId\": \"food\",\n      \"amount\": 2\n    },\n    {\n      \"resourceTypeId\": \"chemicals\",\n      \"amount\": 1\n    }\n  ],\n  \"output\": {\n    \"itemCode\": \"ENERGY_BOOSTER\",\n    \"quantity\": 1\n  },\n  \"unlock\": {\n    \"minLevel\": 2,\n    \"requiredResourceTypeId\": \"chemicals\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"newRecipeName\", \"Molotov \" + Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "pm.collectionVariables.set(\"newRecipeId\", pm.response.json().recipeId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create recipe - invalid (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recipes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Broken\",\n  \"ingredients\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.expect(pm.response.code).to.be.oneOf([400]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update recipe",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recipes/{{newRecipeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipes",
                "{{newRecipeId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{newRecipeName}}\",\n  \"description\": \"Updated\",\n  \"ingredients\": [\n    {\n      \"resourceTypeId\": \"food\",\n      \"amount\": 2\n    },\n    {\n      \"resourceTypeId\": \"chemicals\",\n      \"amount\": 1\n    }\n  ],\n  \"output\": {\n    \"itemCode\": \"ENERGY_BOOSTER\",\n    \"quantity\": 1\n  },\n  \"unlock\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete recipe",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recipes/{{newRecipeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipes",
                "{{newRecipeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.expect(pm.response.code).to.be.oneOf([204]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get recipe - unknown (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recipes/{{newRecipeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipes",
                "{{newRecipeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.expect(pm.response.code).to.be.oneOf([404]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Unlock conditions",
      "item": [
        {
          "name": "Recipes for alice (level 2, passed Linear Algebra)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/players/{{aliceId}}/recipes",
              "host": [
                "{{baseUrl}}"
              ],
