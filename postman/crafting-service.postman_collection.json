          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test(\"each recipe says if it is unlocked\", () => pm.expect(pm.response.json()[0]).to.have.property(\"unlocked\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Recipes for bob (level 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/players/{{bobId}}/recipes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "players",
