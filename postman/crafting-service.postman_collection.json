                "recipes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Craft",
      "item": [
        {
          "name": "Craft Barricade Kit (alice)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/craft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "craft"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{aliceId}}\",\n  \"recipeId\": \"{{barricadeKitId}}\",\n  \"craftId\": \"{{craftId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"craftId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "pm.test(\"completed\", () => pm.expect(pm.response.json().status).to.eql(\"completed\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry the same craftId (idempotent, 200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/craft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "craft"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{aliceId}}\",\n  \"recipeId\": \"{{barricadeKitId}}\",\n  \"craftId\": \"{{craftId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test(\"duplicate\", () => pm.expect(pm.response.json().duplicate).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get craft",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/crafts/{{craftId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "crafts",
