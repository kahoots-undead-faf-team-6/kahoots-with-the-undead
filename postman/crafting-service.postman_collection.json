          "name": "List alice's crafts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/players/{{aliceId}}/crafts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "players",
