          ]
        },
        {
          "name": "Craft without materials (carol, 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/craft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
