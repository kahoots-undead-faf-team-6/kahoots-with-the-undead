              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.expect(pm.response.code).to.be.oneOf([409]));",
                  "pm.test(\"INSUFFICIENT_RESOURCES\", () => pm.expect(pm.response.json().error).to.eql(\"INSUFFICIENT_RESOURCES\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Craft a locked recipe (bob, level 1, 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/craft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
