              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"courseId\": \"{{courseId}}\",\n  \"sessionId\": \"11111111-1111-4111-8111-111111111111\",\n  \"zombieId\": \"dddddddd-0000-4000-8000-000000000001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const x = pm.response.json();",
                  "pm.collectionVariables.set(\"examId\", x.examId);",
                  "pm.collectionVariables.set(\"examQuestionIds\", JSON.stringify(x.questions.map(q => q.questionId)));",
                  "pm.test(\"answers are hidden\", () => x.questions.forEach(q => pm.expect(q).to.not.have.property(\"correctOption\")));"
                ]
              }
            }
          ]
        },
