        {
          "name": "Submit exam (all correct)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/exams/{{examId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "exams",
                "{{examId}}",
                "submit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{answersBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Look up the correct answers (admin endpoint) so this request always passes the exam.",
                  "const base = pm.collectionVariables.get(\"baseUrl\");",
                  "pm.sendRequest(`${base}/courses/${pm.collectionVariables.get(\"courseId\")}/questions`, (err, res) => {",
                  "  const correct = {};",
                  "  res.json().forEach(q => correct[q.questionId] = q.correctOption);",
                  "  const ids = JSON.parse(pm.collectionVariables.get(\"examQuestionIds\"));",
                  "  const answers = ids.map(id => ({ questionId: id, selectedOption: correct[id] }));",
                  "  pm.collectionVariables.set(\"answersBody\", JSON.stringify({ answers }, null, 2));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"passed with 10\", () => { pm.expect(r.passed).to.be.true; pm.expect(r.grade).to.eql(10); });",
                  "pm.test(\"achievements unlocked\", () => pm.expect(r.unlockedAchievements.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
