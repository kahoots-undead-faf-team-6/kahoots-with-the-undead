                  "  [\"service\", \"instanceId\", \"version\", \"status\", \"uptimeSeconds\", \"inFlight\", \"maxConcurrent\", \"load\",",
                  "   \"requestsTotal\", \"errorsTotal\", \"dependencies\", \"circuitBreakers\", \"timestamp\"].forEach(k => pm.expect(s).to.have.property(k));",
                  "});",
                  "pm.test(\"status is UP or DEGRADED\", () => pm.expect([\"UP\", \"DEGRADED\"]).to.include(s.status));",
                  "pm.test(\"load between 0 and 1\", () => { pm.expect(s.load).to.be.at.least(0); pm.expect(s.load).to.be.at.most(1); });",
                  "pm.test(\"version 3.0.0\", () => pm.expect(s.version).to.eql(\"3.0.0\"));",
                  "pm.test(\"service is player-service\", () => pm.expect(s.service).to.eql(\"player-service\"));",
                  "pm.test(\"X-Instance-Id = instanceId\", () => pm.expect(pm.response.headers.get(\"X-Instance-Id\")).to.eql(s.instanceId));"
                ]
              }
            }
          ]
        }
