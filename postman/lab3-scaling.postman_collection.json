{
  "info": {
    "name": "Lab 3 - Scaling Up",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Lab 3 checks for the team stack (deploy/docker-compose.yml). Run the folders in order with the Collection Runner or Newman. Variables: gatewayUrl (http://localhost:8080) and sdUrl (http://localhost:8500); the token comes from '0. Setup' and is sent with collection-level Bearer auth. Folder 6 needs DEMO_MODE=true and makes one Exam instance fail on purpose: restart exam-service afterwards. Folder 7 needs the Service Discovery alerts (Gabriel) and a Telegram/Discord channel in deploy/.env."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "sdUrl",
      "value": "http://localhost:8500"
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "ownerInstance",
      "value": ""
    },
    {
      "key": "wsUrl",
      "value": ""
    },
    {
      "key": "failingInstance",
      "value": ""
    },
    {
      "key": "rr_world",
      "value": "[]"
    },
    {
      "key": "rr_exam",
      "value": "[]"
    },
    {
      "key": "rr_game",
      "value": "[]"
    },
    {
      "key": "cb_ids",
      "value": "[]"
    },
    {
      "key": "cb_count",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "description": "",
      "item": [
        {
          "name": "Get player token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/auth/token",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"playerId\")) pm.collectionVariables.set(\"playerId\", \"aaaaaaaa-0000-4000-8000-000000000001\"); // seeded alice"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);",
                  "[\"rr_world\", \"rr_exam\", \"rr_game\", \"cb_ids\"].forEach(k => pm.collectionVariables.set(k, \"[]\"));",
                  "pm.collectionVariables.set(\"cb_count\", \"0\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Service Discovery (Grades 3, 4)",
      "description": "",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sdUrl}}/health",
              "host": [
                "{{sdUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"service-discovery\", () => pm.expect(pm.response.json().service).to.eql(\"service-discovery\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registry: every instance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sdUrl}}/services",
              "host": [
                "{{sdUrl}}"
              ],
              "path": [
                "services"
              ]
            },
            "description": "Every service registers on startup. Expect 2 replicas of each service, game-1..3 and gateway-1.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const services = pm.response.json().services;",
                  "const up = n => (services[n] || []).filter(i => i.status === \"UP\");",
                  "[\"gateway\", \"game-service\", \"exam-service\", \"world-service\", \"zombie-service\", \"resource-service\", \"base-service\", \"crafting-service\", \"player-service\"].forEach(n => pm.test(n + \" is registered\", () => pm.expect(up(n).length).to.be.at.least(1)));",
                  "[\"exam-service\", \"world-service\", \"zombie-service\", \"resource-service\", \"base-service\", \"crafting-service\", \"player-service\"].forEach(n => pm.test(n + \" has 2+ instances UP\", () => pm.expect(up(n).length).to.be.at.least(2)));",
                  "pm.test(\"game has 3 instances with metadata.wsUrl\", () => {",
                  "  const g = up(\"game-service\");",
                  "  pm.expect(g.length).to.eql(3);",
                  "  g.forEach(i => pm.expect(i.metadata.wsUrl).to.match(/^ws:\\/\\/localhost:310[1-3]\\/ws$/));",
                  "});",
                  "pm.test(\"instance shape (contract §1)\", () => {",
                  "  const i = up(\"gateway\")[0];",
                  "  [\"instanceId\", \"name\", \"host\", \"port\", \"url\", \"metadata\", \"status\", \"registeredAt\", \"lastHeartbeatAt\"].forEach(k => pm.expect(i).to.have.property(k));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Lookup: live Game instances",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sdUrl}}/services/game-service",
              "host": [
                "{{sdUrl}}"
              ],
              "path": [
                "services",
                "game-service"
              ]
            },
            "description": "What the gateway asks for before every /game request (cached 2 s).",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().instances.map(i => i.instanceId);",
                  "pm.test(\"game-1, game-2, game-3\", () => pm.expect(ids).to.eql([\"game-1\", \"game-2\", \"game-3\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown service -> empty list",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sdUrl}}/services/no-such-service",
              "host": [
                "{{sdUrl}}"
              ],
              "path": [
                "services",
                "no-such-service"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"no instances\", () => pm.expect(pm.response.json().instances).to.eql([]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Service Discovery status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sdUrl}}/status",
              "host": [
                "{{sdUrl}}"
              ],
              "path": [
                "status"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"contract fields (docs/lab3-contract.md §2)\", () => {",
                  "  [\"service\", \"instanceId\", \"version\", \"status\", \"uptimeSeconds\", \"inFlight\", \"maxConcurrent\", \"load\",",
                  "   \"requestsTotal\", \"errorsTotal\", \"dependencies\", \"circuitBreakers\", \"timestamp\"].forEach(k => pm.expect(s).to.have.property(k));",
                  "});",
                  "pm.test(\"status is UP or DEGRADED\", () => pm.expect([\"UP\", \"DEGRADED\"]).to.include(s.status));",
                  "pm.test(\"load between 0 and 1\", () => { pm.expect(s.load).to.be.at.least(0); pm.expect(s.load).to.be.at.most(1); });",
                  "pm.test(\"version 3.0.0\", () => pm.expect(s.version).to.eql(\"3.0.0\"));",
                  "pm.test(\"registry size\", () => pm.expect(s.registry.instances).to.be.at.least(15));"
                ]
              }
            }
          ]
        }
      ]
    },
