    {
      "name": "6. Circuit breaker removes a failing instance (Grades 6, 9; needs DEMO_MODE=true)",
      "description": "",
      "item": [
        {
          "name": "Make ONE Exam instance fail",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/exam/debug/fail?enabled=true",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "exam",
                "debug",
                "fail"
              ],
              "query": [
                {
                  "key": "enabled",
                  "value": "true"
                }
              ]
            },
            "description": "Round-robin sends this to one Exam instance; from now on it answers 500 to everything except /health and /status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const id = pm.response.headers.get(\"X-Instance-Id\");",
                  "pm.collectionVariables.set(\"failingInstance\", id);",
                  "console.log(\"failing instance:\", id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Call Exam until the breaker trips",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/exam/courses",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "exam",
                "courses"
              ]
            },
            "description": "Repeats up to 10 times. Half of the calls hit the failing instance (500); after 3 failures inside 3.5 x REQUEST_TIMEOUT_MS the gateway's breaker removes it from the pool and from Service Discovery, and every following call is 200. Logs: 'circuit breaker tripped', 'instance removed by circuit breaker'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.collectionVariables.get(\"cb_count\")) + 1;",
                  "pm.collectionVariables.set(\"cb_count\", String(n));",
                  "const ids = JSON.parse(pm.collectionVariables.get(\"cb_ids\") || \"[]\");",
                  "ids.push(pm.response.code + \"@\" + pm.response.headers.get(\"X-Instance-Id\"));",
                  "pm.collectionVariables.set(\"cb_ids\", JSON.stringify(ids));",
                  "if (n < 10) { postman.setNextRequest(pm.info.requestName); } else {",
                  "  console.log(ids.join(\"  \"));",
                  "  pm.test(\"the last 4 calls all succeed (failing instance removed)\", () => ids.slice(-4).forEach(x => pm.expect(x).to.match(/^200@/)));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Service Discovery: failing instance is gone",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sdUrl}}/services/exam-service",
              "host": [
                "{{sdUrl}}"
              ],
              "path": [
                "services",
                "exam-service"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().instances.map(i => i.instanceId);",
                  "const bad = pm.collectionVariables.get(\"failingInstance\");",
                  "pm.test(bad + \" removed\", () => pm.expect(ids).to.not.include(bad));",
                  "pm.test(\"the healthy instance stays\", () => pm.expect(ids.length).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Quarantine: it cannot register again for 60 s",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sdUrl}}/quarantine",
              "host": [
                "{{sdUrl}}"
              ],
              "path": [
                "quarantine"
              ]
            },
            "description": "After the demo: docker compose -f deploy/docker-compose.yml restart exam-service (the failing switch lives in memory).",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const bad = pm.collectionVariables.get(\"failingInstance\");",
                  "pm.test(bad + \" quarantined\", () => pm.expect(pm.response.json().instances.map(i => i.instanceId)).to.include(bad));"
                ]
              }
            }
          ]
        }
      ]
    },
