    {
      "name": "Lab 2: ExamPassed through the gateway",
      "description": "Needs the team stack (deploy/docker-compose.yml). A new player passes the PAD exam: Exam saves the grade and sends ExamPassed to World, World checks it with Exam (World -> gateway -> Exam) and unlocks the East Wing. Every run registers a new player, so the folder can be run again; after the first run the wing is already unlocked.",
      "item": [
        {
          "name": "Register a new player (public route)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{gatewayUrl}}/player/auth/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "player",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{lab2Username}}\",\n  \"email\": \"{{lab2Username}}@faf.utm.md\",\n  \"password\": \"password123\",\n  \"displayName\": \"World tester\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"lab2Username\", \"world_\" + Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"playerToken\", pm.response.json().token);",
                  "pm.collectionVariables.set(\"lab2PlayerId\", pm.response.json().player.playerId);"
                ]
              }
            }
          ]
        },
        {
          "name": "PAD questions with answers (Exam)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{gatewayUrl}}/exam/courses/{{padCourseId}}/questions",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "exam",
                "courses",
                "{{padCourseId}}",
                "questions"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{playerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const answers = {};",
                  "pm.response.json().forEach(q => { answers[q.questionId] = q.correctOption; });",
                  "pm.test(\"questions found\", () => pm.expect(Object.keys(answers).length).to.be.above(0));",
                  "pm.collectionVariables.set(\"padAnswers\", JSON.stringify(answers));"
                ]
              }
            }
          ]
        },
        {
          "name": "Start the PAD exam (Exam)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{gatewayUrl}}/exam/exams",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "exam",
                "exams"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{lab2PlayerId}}\",\n  \"courseId\": \"{{padCourseId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{playerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"examId\", pm.response.json().examId);",
                  "pm.collectionVariables.set(\"examQuestionIds\", JSON.stringify(pm.response.json().questions.map(q => q.questionId)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pass the exam (Exam -> World ExamPassed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{gatewayUrl}}/exam/exams/{{examId}}/submit",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "exam",
                "exams",
                "{{examId}}",
                "submit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": {{examAnswers}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{playerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const answers = JSON.parse(pm.collectionVariables.get(\"padAnswers\"));",
                  "const ids = JSON.parse(pm.collectionVariables.get(\"examQuestionIds\"));",
                  "pm.variables.set(\"examAnswers\", JSON.stringify(ids.map(id => ({ questionId: id, selectedOption: answers[id] }))));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"passed\", () => pm.expect(pm.response.json().passed).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "East Wing is unlocked (World)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{gatewayUrl}}/world/wings",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "world",
                "wings"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{playerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const wing = pm.response.json().find(w => w.requiredCourseId === pm.collectionVariables.get(\"padCourseId\"));",
                  "pm.test(\"East Wing needs the PAD course\", () => pm.expect(wing).to.be.ok);",
                  "pm.test(\"unlocked by the exam\", () => pm.expect(wing.unlocked).to.eql(true));",
                  "pm.collectionVariables.set(\"eastWingId\", wing.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Server Room is now available (World)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{gatewayUrl}}/world/rooms?available=true",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "world",
                "rooms"
              ],
              "query": [
                {
                  "key": "available",
                  "value": "true"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{playerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Server Room open\", () => pm.expect(pm.response.json().map(r => r.name)).to.include(\"Server Room\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verified ExamPassed (World -> Exam)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Exam confirms this player passed PAD, so World accepts the event. The wing is already unlocked, so nothing changes.",
            "url": {
              "raw": "{{gatewayUrl}}/world/events/exam-passed",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "world",
                "events",
                "exam-passed"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{lab2PlayerId}}\",\n  \"courseId\": \"{{padCourseId}}\",\n  \"category\": \"NETWORKS\",\n  \"grade\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{playerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"idempotent: already unlocked\", () => pm.expect(pm.response.json().alreadyUnlocked.map(w => w.id)).to.include(pm.collectionVariables.get(\"eastWingId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Fake ExamPassed -> 422 (World -> Exam)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "The player never took Linear Algebra, so Exam does not confirm the event and World refuses it.",
            "url": {
              "raw": "{{gatewayUrl}}/world/events/exam-passed",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "world",
                "events",
                "exam-passed"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{lab2PlayerId}}\",\n  \"courseId\": \"{{linearAlgebraCourseId}}\",\n  \"category\": \"MATH\",\n  \"grade\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{playerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"not verified\", () => pm.expect(pm.response.json().error).to.eql(\"EXAM_NOT_VERIFIED\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
