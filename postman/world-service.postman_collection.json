        {
          "name": "Exam Passed event (standalone, mocked Exam)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"11111111-1111-1111-1111-111111111111\",\n  \"courseId\": \"course-2\",\n  \"category\": \"MIDTERM\",\n  \"grade\": 8.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/events/exam-passed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "exam-passed"
              ]
            },
            "description": "Only for World run on its own (baseUrl http://localhost:3011, EXAM_SERVICE_URL empty): the mocked Exam accepts the event for the wing above (course-2 after Replace Wing), which Unlock Wing already opened, so it comes back in alreadyUnlocked. Through the gateway World checks the event with the real Exam Service, so this fake player gets 422 EXAM_NOT_VERIFIED: use the folder 'Lab 2: ExamPassed through the gateway' instead."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"wing unlocked\", () => pm.expect(pm.response.json().unlocked.concat(pm.response.json().alreadyUnlocked).map(w => w.id)).to.include(pm.collectionVariables.get(\"wingId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Wing",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wings/{{wingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wings",
                "{{wingId}}"
              ]
            }
          }
        }
      ]
