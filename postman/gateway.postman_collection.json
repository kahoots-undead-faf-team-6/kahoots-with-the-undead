{
  "info": {
    "name": "Lab 2 - API Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Everything goes through the gateway (port 8080). Run the folders in order. The token from '1. Auth' is used for every request through collection-level Bearer auth; admin requests use adminToken."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Gateway",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{gatewayUrl}}/health",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Services health",
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{gatewayUrl}}/health/services",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "health",
                "services"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"game up\", () => pm.expect(pm.response.json().services.game).to.eql(\"up\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Get player token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{gatewayUrl}}/auth/token",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"playerId\")) { pm.collectionVariables.set(\"playerId\", \"aaaaaaaa-0000-4000-8000-000000000001\"); } // seeded alice in Player Service"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);",
                  "pm.test(\"bearer\", () => pm.expect(pm.response.json().tokenType).to.eql(\"Bearer\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get admin token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "adminKey must match ADMIN_KEY in deploy/.env",
            "url": {
              "raw": "{{gatewayUrl}}/auth/token",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"admin-1\",\n  \"role\": \"admin\",\n  \"adminKey\": \"{{adminKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"adminToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
