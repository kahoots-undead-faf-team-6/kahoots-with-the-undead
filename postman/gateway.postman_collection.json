    {
      "name": "7. Across services (World + Zombie seeded)",
      "description": "A full game through the gateway: Player login, World rooms, Zombie types, Game -> Exam, Game -> Player. Needs the World and Zombie seed scripts (README section 10).",
      "item": [
        {
          "name": "Player login (public route)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{gatewayUrl}}/player/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "player",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"password123\"\n}",
              "options": {
