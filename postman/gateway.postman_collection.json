    {
      "name": "4. WebSocket negotiation",
      "item": [
        {
          "name": "Negotiate WebSocket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Open the returned wsUrl in a Postman WebSocket tab (or wscat -c). The connection goes straight to Game, not through the gateway.",
            "url": {
              "raw": "{{gatewayUrl}}/ws/negotiate",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "ws",
                "negotiate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"wsUrl\", pm.response.json().wsUrl);",
                  "pm.test(\"direct URL to Game with token\", () => { const u = pm.response.json().wsUrl; pm.expect(u).to.match(/^ws:\\/\\//); pm.expect(u).to.include(\"token=\"); });"
                ]
              }
            }
          ]
        },
