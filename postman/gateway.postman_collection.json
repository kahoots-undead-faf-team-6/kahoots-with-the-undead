    {
      "name": "6. Limits (needs DEMO_MODE=true)",
      "description": "Set DEMO_MODE=true in deploy/.env. 429: run this folder with the Collection Runner (or the curl loop in the README) with MAX_CONCURRENT_REQUESTS set low.",
      "item": [
        {
          "name": "Game timeout -> 408",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Game's own timeout (SERVICE_REQUEST_TIMEOUT_MS, 5000) fires before the gateway's (10000).",
            "url": {
              "raw": "{{gatewayUrl}}/game/debug/slow?ms=8000",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "game",
                "debug",
                "slow"
              ],
              "query": [
                {
                  "key": "ms",
                  "value": "8000"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 408\", () => pm.response.to.have.status(408));",
                  "pm.test(\"error REQUEST_TIMEOUT\", () => pm.expect(pm.response.json().error).to.eql(\"REQUEST_TIMEOUT\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway timeout -> 504",
          "request": {
            "method": "GET",
            "header": [],
            "description": "The gateway's own timeout (GATEWAY_REQUEST_TIMEOUT_MS, 10000).",
            "url": {
              "raw": "{{gatewayUrl}}/debug/slow?ms=15000",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
